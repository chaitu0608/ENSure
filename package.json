{
  "name": "ensure",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "test": "vitest run --exclude server/test/e2e.test.ts",
    "e2e": "vitest run server/test/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "setup-ens": "tsx --env-file-if-exists=.env scripts/setup-ens.ts",
    "ensure": "tsx --env-file-if-exists=.env cli/src/index.ts",
    "verify:sepolia": "tsx --env-file-if-exists=.env tools/ensure-sepolia/scripts/verify-sepolia.ts",
    "owner:build": "tsx tools/ensure-sepolia/scripts/build-owner-promote.ts",
    "owner:prepare": "tsx --env-file-if-exists=.env tools/ensure-sepolia/scripts/prepare-owner-promote.ts",
    "owner:publish": "tsx --env-file-if-exists=.env tools/ensure-sepolia/scripts/publish-owner-promote.ts"
  },
  "dependencies": {
    "@ensure/core": "workspace:*",
    "viem": "^2",
    "canonicalize": "5.1.0",
    "multiformats": "14.0.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "esbuild": "0.28.2"
  }
}
